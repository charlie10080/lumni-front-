rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Funciones Auxiliares de Autenticación y Rol
    // ==========================================
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtiene los datos del perfil del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verifica si el usuario tiene rol de Maestro / Docente Titular
    function isTeacher() {
      return isAuthenticated() && (
        getUserData().rol == 'teacher' ||
        request.auth.token.role == 'teacher'
      );
    }
    
    // ==========================================
    // 1. Perfiles de Usuario (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // Cada usuario lee y actualiza su propio perfil
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      // Creación de usuario durante el registro inicial
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 2. Aulas de Docentes Multi-Tenant (/classrooms/{teacherId})
    // ==========================================
    match /classrooms/{teacherId} {
      // El maestro titular tiene acceso total y exclusivo a su aula
      allow read, write: if isAuthenticated() && request.auth.uid == teacherId;
      // Los padres/tutores autenticados pueden leer el aula de su docente asignado
      allow read: if isAuthenticated();
    }

    // ==========================================
    // 3. Directorio de Búsqueda para Padres (/student_lookup/{lookupKey})
    // ==========================================
    match /student_lookup/{lookupKey} {
      // Permite búsqueda por CURP o Matrícula para acceso escolar de familias
      allow read: if true;
      // Solo maestros autenticados pueden registrar y actualizar los índices de búsqueda de sus alumnos
      allow write: if isAuthenticated();
    }

    // ==========================================
    // 4. Colecciones Clásicas (Retrocompatibilidad)
    // ==========================================
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }
    
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /threads/{threadId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /incidents/{incidentId} {
      allow read, write: if isAuthenticated();
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /schoolInfo/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
  }
}
