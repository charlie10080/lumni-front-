rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Funciones Auxiliares de Autenticación y Rol
    // ==========================================
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtiene los datos del perfil del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verifica si el usuario tiene rol de Maestro / Docente Titular
    function isTeacher() {
      return isAuthenticated() && (
        getUserData().rol == 'teacher' ||
        request.auth.token.role == 'teacher'
      );
    }
    
    // Administrador de la plataforma: existe el documento /admins/{uid} (solo se crea a mano en la consola)
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cuenta no bloqueada (un perfil sin estado se considera activo).
    // La vigencia (vigenteHasta) se aplica en la app al iniciar sesión; aquí solo se corta por bloqueo.
    function isActiveAccount() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(p) || get(p).data.get('estado', 'activo') != 'bloqueado';
    }

    // Campos que solo controla el administrador
    function adminOnlyFieldsUnchanged() {
      return request.resource.data.get('estado', null) == resource.data.get('estado', null)
        && request.resource.data.get('vigenteHasta', null) == resource.data.get('vigenteHasta', null)
        && request.resource.data.get('notaAdmin', null) == resource.data.get('notaAdmin', null);
    }

    // ==========================================
    // 0. Administradores (/admins/{uid})
    // ==========================================
    match /admins/{uid} {
      // Cada quien solo puede comprobar si él mismo es admin; nadie crea admins desde la app
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ==========================================
    // 1. Perfiles de Usuario (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // Cada usuario lee su perfil; el administrador lee todos
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Nadie puede cambiar su propio rol ni los campos de bloqueo/vigencia (solo el admin)
      allow update: if (isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.get('rol', null) == resource.data.get('rol', null)
                    && adminOnlyFieldsUnchanged())
                    || (isAdmin() && request.resource.data.get('rol', null) == resource.data.get('rol', null));
      // Creación de usuario durante el registro inicial (sin bloqueo ni vigencia propios)
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && !('estado' in request.resource.data) && !('vigenteHasta' in request.resource.data)
                    && !('notaAdmin' in request.resource.data);
      // Un usuario no puede borrar su perfil (así no se salta un bloqueo)
      allow delete: if false;
    }

    // ==========================================
    // 2. Aulas de Docentes Multi-Tenant (/classrooms/{teacherId})
    // ==========================================
    match /classrooms/{teacherId} {
      // Solo el maestro titular accede a su aula completa. Los padres ya no leen esta colección.
      allow read: if isAuthenticated() && request.auth.uid == teacherId;
      allow write: if isAuthenticated() && request.auth.uid == teacherId && isActiveAccount();
    }

    // ==========================================
    // 3. Vista de padres (/parent_views/{clave})
    // ==========================================
    // Un documento por alumno, con SOLO los datos de ese alumno. La clave es su CURP,
    // matrícula o código de acceso. Se puede leer con la clave exacta, pero no listar.
    match /parent_views/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && request.resource.data.teacherId == request.auth.uid && isActiveAccount();
      allow update: if isAuthenticated() && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == request.auth.uid && isActiveAccount();
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ==========================================
    // 3a. Índice de CURP (/parent_index/{CURP}) -> código de acceso del alumno
    // ==========================================
    // Se consulta por la CURP exacta (no se puede listar). Solo el docente dueño lo escribe.
    match /parent_index/{curp} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.code is string && isActiveAccount();
      allow update: if isAuthenticated() && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.code is string && isActiveAccount();
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ==========================================
    // 3b. Chat maestro-padre
    // ==========================================
    // /parent_chats/{codigoAcceso}            -> resumen (último mensaje y no leídos)
    // /parent_chats/{codigoAcceso}/messages/* -> mensajes
    // La clave es el código de acceso del alumno (también es una clave de parent_views).
    // Quien conoce el código es el padre; el maestro dueño se verifica con parent_views.teacherId.
    match /parent_chats/{code} {
      function viewPath() {
        return /databases/$(database)/documents/parent_views/$(code);
      }
      function isChatTeacher() {
        return isAuthenticated() && exists(viewPath()) && get(viewPath()).data.teacherId == request.auth.uid;
      }
      function validSummary() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentId', 'lastText', 'lastAt', 'lastFrom', 'unreadTeacher', 'unreadParent'])
          && (!('lastText' in d) || (d.lastText is string && d.lastText.size() <= 200))
          && (!('lastFrom' in d) || d.lastFrom in ['teacher', 'parent'])
          && (!('unreadTeacher' in d) || (d.unreadTeacher is int && d.unreadTeacher >= 0))
          && (!('unreadParent' in d) || (d.unreadParent is int && d.unreadParent >= 0));
      }

      allow read: if exists(viewPath());
      allow create, update: if exists(viewPath()) && validSummary();

      match /messages/{msgId} {
        function validMessage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['remitente', 'texto', 'createdAt', 'studentId'])
            && d.remitente in ['teacher', 'parent']
            && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000
            && d.createdAt is string
            && d.studentId is string
            && (d.remitente == 'parent' || isChatTeacher());
        }

        allow read: if exists(viewPath());
        allow create: if exists(viewPath()) && validMessage();
        // Los mensajes no se editan; solo el docente puede borrarlos
        allow update: if false;
        allow delete: if isChatTeacher();
      }
    }

    // Índice anterior (contenía teléfonos y correos de tutores y era público): ya no se lee ni se escribe.
    // Cada docente puede borrar los suyos.
    match /student_lookup/{lookupKey} {
      allow read, create, update: if false;
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // ==========================================
    // 4. Colecciones Clásicas (Retrocompatibilidad)
    // ==========================================
    // Colecciones heredadas sin uso en la app actual: cerradas por completo.
    // (Antes permitían a cualquier usuario autenticado leer y escribir datos de alumnos.)
    match /students/{studentId} {
      allow read, write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /threads/{threadId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
    
    match /incidents/{incidentId} {
      allow read, write: if false;
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    match /schoolInfo/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
  }
}
