rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fotos de perfil y avatares (máx 5MB, solo imágenes)
    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Fotos de alumnos (menores): sin uso en la app actual, cerradas hasta definir
    // acceso por docente dueño del aula.
    match /student_photos/{studentId}/{fileName} {
      allow read, write: if false;
    }

    // Adjuntos de avisos institucionales (imágenes o PDF, máx 10MB)
    match /notices/{noticeId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false // sin uso actual; reabrir solo para docentes
                    && request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
